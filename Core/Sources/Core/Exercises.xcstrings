      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich auf eine Schrägbank im 45-Grad-Winkel und halte in jeder Hand eine Kurzhantel."
          }
        }
      }
    },
    "Sit on an Incline Bench while holding a dumbbell on each hand on top of your thighs." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich auf eine Schrägbank, in jeder Hand eine Kurzhantel auf den Oberschenkeln."
          }
        }
      }
    },
    "Sit on the bench and place the ball of your feet on the block." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich auf die Bank und stelle die Fußballen auf den Block."
