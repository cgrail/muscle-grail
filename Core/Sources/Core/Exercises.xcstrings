      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich ab, indem du den Ellbogen beugst, bis du den Boden berührst."
          }
        }
      }
    },
    "Lower yourself by extending at the knee, taking care to NOT flex the hips as you go forward." : {
