          }
        }
      }
    },
    "Hold a dumbbell in each hand and lie back on an incline bench." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte in jeder Hand eine Kurzhantel und leg dich auf eine Schrägbank."
