      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorgebeugtes Rudern mit zwei Kurzhanteln, Handflächen zueinander"
          }
        }
      }
    },
    "Bent Press" : {
      "extractionState" : "manual",
