    "Come back to the starting position as you breathe in and then repeat the movement but this time to the right side of the body. Tip: Use a slow controlled movement at all times. Jerking motions can injure the back." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre einatmend in die Ausgangsposition zurück und wiederhole die Bewegung zur rechten Seite. Tipp: Bewege dich immer langsam und kontrolliert. Ruckartige Bewegungen können den Rücken verletzen."
          }
        }
      }
    },
    "Complete the prescribed number of circles in one direction, then repeat the same number in the opposite direction." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mache die vorgegebene Anzahl Kreise in eine Richtung und dann genauso viele in die andere Richtung."
          }
        }
      }
    },
    "Conan's Wheel" : {
      "extractionState" : "manual",
