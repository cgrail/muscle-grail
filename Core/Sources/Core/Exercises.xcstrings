      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole die Bewegung für die empfohlene Anzahl an Wiederholungen und wechsle dabei die Beine."
          }
        }
      }
    },
    "Repeat the movement for the specified amount of repetitions." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole die Bewegung für die vorgegebene Anzahl an Wiederholungen."
          }
        }
      }
    },
    "Repeat the movement with the left hand. This equals one repetition." : {
