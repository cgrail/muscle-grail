            "value" : "Schulterdrücken mit Bändern"
          }
        }
      }
    },
    "Shoulder Raise" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schulterheben"
          }
        }
      }
    },
    "Shoulder Stretch" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schulterdehnung"
          }
        }
      }
    },
    "Shrug your shoulders towards your ears. While this exercise can usually by loaded with heavier weight than a clean, avoid overloading to the point that the execution slows down." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Schultern zu den Ohren hoch. Du kannst bei dieser Übung meist mehr Gewicht nehmen als beim Umsetzen, überlade aber nicht so weit, dass die Ausführung langsamer wird."
          }
        }
      }
    },
    "Shrug your shoulders towards your ears. While this exercise can usually by loaded with heavier weight than a snatch, avoid overloading to the point that the execution slows down." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Schultern zu den Ohren hoch. Du kannst bei dieser Übung meist mehr Gewicht nehmen als beim Reißen, überlade aber nicht so weit, dass die Ausführung langsamer wird."
          }
        }
      }
    },
    "Side Bridge" : {
