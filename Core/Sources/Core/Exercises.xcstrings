          }
        }
      }
    },
    "Lower the kettlebell and immediately press the other kettlebell. Make sure to do the same amount of reps on both sides." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke die Kettlebell und drücke sofort die andere. Mache auf beiden Seiten gleich viele Wiederholungen."
          }
        }
      }
    },
    "Lower the kettlebell back to the starting position and repeat." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke die Kettlebell zurück in die Ausgangsposition und wiederhole das."
          }
        }
      }
    },
    "Lower the kettlebell back to your shoulder under control and repeat. Make sure to contract your lat, butt, and stomach forcefully for added stability and strength." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke die Kettlebell kontrolliert zurück zur Schulter und wiederhole das. Spanne Latissimus, Gesäß und Bauch kräftig an, um mehr Stabilität und Kraft zu haben."
          }
        }
      }
    },
    "Lower the kettlebell in the working arm and repeat with your other arm." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke die Kettlebell im arbeitenden Arm ab und wiederhole das mit dem anderen Arm."
          }
        }
      }
    },
    "Lower the kettlebell, keeping the hamstrings loaded by keeping your back straight and your butt out." : {
      "extractionState" : "manual",
