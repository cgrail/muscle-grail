      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte unten inne und führe die Gewichte oben zusammen, indem du die Ellbogen streckst."
          }
        }
      }
    },
    "Pause at the completion of the movement, and then slowly return the weight to the starting position." : {
      "extractionState" : "manual",
