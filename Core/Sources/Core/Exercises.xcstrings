      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole das mit dem anderen Bein."
          }
        }
      }
    },
    "Repeat for your prescribed number of repetitions and then repeat with the right leg." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole das für die vorgegebene Anzahl an Wiederholungen und dann mit dem rechten Bein."
          }
        }
      }
    },
    "Repeat on the opposite side, alternating until the set is complete." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole das mit der anderen Seite und wechsle ab, bis der Satz fertig ist."
          }
        }
      }
    },
    "Repeat on the other side." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole das auf der anderen Seite."
          }
        }
      }
    },
    "Repeat once more with your right leg, and as soon as the right foot strikes the ground hammer them out rapidly, alternating left and right as fast as you can." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole das noch einmal mit dem rechten Bein und trommle, sobald der rechte Fuß den Boden trifft, so schnell du kannst abwechselnd links und rechts."
          }
        }
      }
    },
    "Repeat steps 3-6 until the recommended amount of repetitions is performed." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole die Schritte 3–6, bis du die empfohlene Anzahl an Wiederholungen geschafft hast."
          }
        }
      }
    },
    "Repeat steps 3-6 until you have performed the prescribed amount of repetitions for each side." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole die Schritte 3–6, bis du die vorgegebene Anzahl an Wiederholungen pro Seite geschafft hast."
          }
        }
      }
    },
    "Repeat the motion to return to the starting position." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole die Bewegung, um in die Ausgangsposition zurückzukommen."
          }
        }
      }
    },
    "Repeat the movement for the prescribed amount of repetitions of your training program." : {
