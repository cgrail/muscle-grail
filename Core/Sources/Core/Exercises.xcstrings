      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medizinball-Volldrehung"
          }
        }
      }
    },
    "Medicine Ball Scoop Throw" : {
      "extractionState" : "manual",
