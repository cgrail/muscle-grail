      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorgebeugtes Rudern mit zwei Kurzhanteln"
          }
        }
      }
    },
    "Bent Over Two-Dumbbell Row With Palms In" : {
      "extractionState" : "manual",
