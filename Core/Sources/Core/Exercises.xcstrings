    "Car Drivers" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Car Drivers"
          }
        }
      }
    },
    "Carefully guide the bell back to the floor, keeping it under control as much as possible. It is best to perform this event on a thick rubber mat to prevent damage to the floor." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe die Hantel vorsichtig und möglichst kontrolliert zurück auf den Boden. Am besten machst du diese Übung auf einer dicken Gummimatte, um den Boden zu schonen."
          }
        }
      }
    },
    "Carefully jump down to the other side of the box, and continue going back and forth for several repetitions." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Springe vorsichtig auf der anderen Seite der Box herunter und wiederhole das einige Male hin und her."
          }
        }
      }
    },
    "Carefully lift the pole up and behind your head." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebe die Stange vorsichtig nach oben und hinter deinen Kopf."
          }
        }
      }
    },
    "Carefully return the weight to floor." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege das Gewicht vorsichtig zurück auf den Boden."
          }
        }
      }
    },
