      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz dich auf die Maschine und stelle die Zehen auf den unteren Teil der Plattform, die Fersen ragen über den Rand. Wähle die Zehenstellung, die du möchtest (nach vorn, innen oder außen)."
          }
        }
      }
    },
    "Sit on the machine with your back flat on the pad." : {
      "extractionState" : "manual",
