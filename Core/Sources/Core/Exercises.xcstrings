      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Langhantel im Obergriff (Handflächen nach unten), etwas enger als schulterbreit."
          }
        }
      }
    },
    "Hold a barbell with both hands and your palms facing down; hands spaced about shoulder width." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Langhantel mit beiden Händen im Obergriff, die Hände etwa schulterbreit."
          }
        }
      }
    },
    "Hold a barbell with both hands and your palms facing down; hands spaced about shoulder width. This will be your starting position." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
