            "value" : "Kniende Kniebeuge"
          }
        }
      }
    },
    "Land facing the same direction with your feet hip width apart, absorbing the impact through your lower body." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande mit Blick in dieselbe Richtung, die Füße hüftbreit, und fange den Aufprall mit dem Unterkörper ab."
          }
        }
      }
    },
    "Land in the opposite position that you started, on the opposite side of the box. The foot that was initially on the box will now be on the ground, with the opposite foot now on the box." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande auf der anderen Seite der Box in der umgekehrten Position: Der Fuß, der zuerst auf der Box war, steht jetzt auf dem Boden, der andere Fuß auf der Box."
          }
        }
      }
    },
    "Land in the same position that you started, using your inside leg to decelerate the impact." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande in derselben Position wie zu Beginn und fange den Aufprall mit dem inneren Bein ab."
          }
        }
      }
    },
    "Land on the box with both feet, absorbing the impact by allowing the hips and knees to bend." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande mit beiden Füßen auf der Box und fange den Aufprall ab, indem du Hüfte und Knie beugst."
          }
        }
      }
    },
    "Land on the box with the knees bent, absorbing the impact through the legs. You can jump from the box back to the ground, or preferably step down one leg at a time." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande mit gebeugten Knien auf der Box und fange den Aufprall mit den Beinen ab. Du kannst von der Box zurück auf den Boden springen oder besser nacheinander mit einem Bein heruntersteigen."
          }
        }
      }
    },
    "Land on the center of the box, using your legs to absorb the impact." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande in der Mitte der Box und fange den Aufprall mit den Beinen ab."
          }
        }
      }
    },
    "Land on your jumping leg, and immediately rebound out of it by jumping back to the start position." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande auf dem Sprungbein und federe sofort zurück in die Ausgangsposition."
          }
        }
      }
    },
    "Land softly, asborbing the impact through the legs." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande weich und fange den Aufprall mit den Beinen ab."
          }
        }
      }
    },
    "Land with the opposite foot on top of the box, returning your other foot back to the start position." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande mit dem anderen Fuß auf der Box und bring den ersten Fuß zurück in die Ausgangsposition."
          }
        }
      }
    },
    "Land with the same foot on top of the box, returning your other foot back to the start position." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lande mit demselben Fuß auf der Box und bring den anderen Fuß zurück in die Ausgangsposition."
          }
        }
      }
    },
    "Landmine 180's" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Landmine 180s"
          }
        }
      }
    },
    "Landmine Linear Jammer" : {
      "extractionState" : "manual",
