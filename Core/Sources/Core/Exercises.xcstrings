    "Standing straight up, lace your fingers together and open your palms to the ceiling. Keep your shoulders down as you extend your arms up." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh aufrecht, verschränke die Finger und öffne die Handflächen zur Decke. Halte die Schultern unten, während du die Arme nach oben streckst."
          }
        }
      }
    },
    "Standing Toe Touches" : {
