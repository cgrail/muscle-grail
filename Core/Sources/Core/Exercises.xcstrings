    "Supine Chest Throw" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brustwurf in Rückenlage"
          }
        }
      }
    },
    "Supine One-Arm Overhead Throw" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einarmiger Überkopfwurf in Rückenlage"
          }
        }
      }
    },
    "Supine Two-Arm Overhead Throw" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beidarmiger Überkopfwurf in Rückenlage"
          }
        }
      }
    },
    "Support your weight on your left leg and place your left hand on your left thigh." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stütze dein Gewicht auf das linke Bein und lege die linke Hand auf den linken Oberschenkel."
          }
        }
      }
    },
    "Suspend your straps at around chest height. Take a handle in each hand and lean back. Keep your body erect and your head and chest up. Your arms should be fully extended. This will be your starting position." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänge deine Schlingen etwa auf Brusthöhe auf. Nimm in jede Hand einen Griff und lehne dich zurück. Halte den Körper gerade, Kopf und Brust oben. Deine Arme sind ganz gestreckt. Das ist deine Ausgangsposition."
          }
        }
      }
    },
    "Suspend your straps so the handles are 18-30 inches from the floor." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hänge deine Schlingen so auf, dass die Griffe 45–75 cm über dem Boden sind."
          }
        }
      }
    },
    "Suspended Fallout" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallout im Schlingentrainer"
          }
        }
      }
    },
