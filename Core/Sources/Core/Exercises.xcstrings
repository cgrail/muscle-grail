      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke dich so weit wie möglich ab."
          }
        }
      }
    },
    "Lower yourself by allowing the elbow to flex until you touch the ground." : {
