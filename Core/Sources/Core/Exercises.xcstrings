      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole die Bewegung für die empfohlene Anzahl an Wiederholungen und mache sie dann mit dem linken Bein."
          }
        }
      }
    },
    "Repeat the movement for the recommended amount of repetitions, alternating legs." : {
      "extractionState" : "manual",
