    "Lying High Bench Barbell Curl" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langhantelcurl liegend auf hoher Bank"
          }
        }
      }
    },
    "Lying Leg Curls" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegende Beincurls"
          }
        }
      }
    },
    "Lying Machine Squat" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegende Maschinenkniebeuge"
          }
        }
      }
    },
    "Lying on the bench, get your head beyond the bar if possible. Tuck your feet underneath you and arch your back. Using the bar to help support your weight, lift your shoulder off the bench and retract them, squeezing the shoulder blades together. Use your feet to drive your traps into the bench. Maintain this tight body position throughout the movement. However wide your grip, it should cover the ring on the bar." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg dich auf die Bank, den Kopf möglichst hinter der Stange. Ziehe die Füße unter dich und mache ein Hohlkreuz. Stütze dich an der Stange ab, hebe die Schultern von der Bank und ziehe sie zurück, die Schulterblätter zusammengedrückt. Drücke dich mit den Füßen so ab, dass dein Trapezmuskel in die Bank gedrückt wird. Halte diese feste Körperspannung während der ganzen Bewegung. Wie breit du auch greifst, deine Hand sollte den Ring auf der Stange bedecken."
          }
        }
      }
    },
    "Lying One-Arm Lateral Raise" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegendes einarmiges Seitheben"
          }
        }
      }
    },
    "Lying Prone Quadriceps" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadrizepsdehnung in Bauchlage"
          }
        }
      }
    },
    "Lying Rear Delt Raise" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegendes Seitheben für die hintere Schulter"
          }
        }
      }
    },
    "Lying Supine Dumbbell Curl" : {
