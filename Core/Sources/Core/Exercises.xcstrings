          }
        }
      }
    },
    "Do one pushup and as you come up, shift your weight on the left side of the body, twist to the side while bringing the right arm up towards the ceiling in a side plank." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mache einen Liegestütz und verlagere beim Hochkommen dein Gewicht auf die linke Körperseite. Drehe dich zur Seite und strecke den rechten Arm in den Seitstütz zur Decke."
          }
        }
      }
    },
