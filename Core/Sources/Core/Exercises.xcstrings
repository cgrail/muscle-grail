      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Unterarme bewegen sich. Führe die Bewegung fort, bis der Bizeps voll angespannt und die Kurzhanteln auf Schulterhöhe sind. Halte die Spannung eine Sekunde und drücke den Bizeps zusammen."
          }
        }
      }
    },
