          }
        }
      }
    },
    "Frog Hops" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Froschsprünge"
          }
        }
      }
    },
    "Frog Sit-Ups" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frosch-Sit-ups"
          }
        }
      }
    },
    "From a hanging position, raise yourself a few inches without using your arms. Do this by depressing your shoulder girdle in a reverse shrugging motion." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebe dich aus dem Hang ein paar Zentimeter an, ohne die Arme zu beugen. Dazu ziehst du den Schultergürtel nach unten, wie bei einem umgekehrten Schulterheben."
          }
        }
      }
    },
    "From a lying position, bend your knees and keep your feet on the floor." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beuge im Liegen die Knie und lass die Füße auf dem Boden."
          }
        }
      }
    },
    "From a standing position, place a bent arm against a wall or doorway." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege im Stehen einen gebeugten Arm an eine Wand oder einen Türrahmen."
          }
        }
      }
    },
    "From the starting position, breathe in and begin coming down slowly until the bar touches your middle chest." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme in der Ausgangsposition ein und senke die Stange langsam, bis sie die Mitte deiner Brust berührt."
          }
        }
      }
    },
    "From this position, extend your elbows to press the kettlebell up and overhead until your arms are straight, keeping your upper arms alongside your head." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strecke aus dieser Position die Ellbogen und drücke die Kettlebell über den Kopf, bis die Arme gestreckt sind. Die Oberarme bleiben neben dem Kopf."
          }
        }
      }
    },
    "Front Barbell Squat" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langhantel-Frontkniebeuge"
          }
        }
      }
    },
