      }
    },
    "Hold a dumbbell in each hand and lie on an incline bench that is set to an incline angle of no more than 30 degrees." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte in jeder Hand eine Kurzhantel und leg dich auf eine Schrägbank mit höchstens 30 Grad Neigung."
          }
        }
      }
    },
    "Hold a dumbbell in each hand with a pronated grip. Your feet should be wide with your hips and knees extended. This will be your starting position." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte in jeder Hand eine Kurzhantel im Obergriff. Die Füße stehen breit, Hüfte und Knie sind gestreckt. Das ist deine Ausgangsposition."
          }
        }
      }
    },
    "Hold a dumbbell in each hand, letting them hang at the sides. This will be your starting position." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte in jeder Hand eine Kurzhantel seitlich hängend. Das ist deine Ausgangsposition."
          }
        }
      }
    },
    "Hold a dumbbell in your uppermost arm while keeping it extended in front of you parallel to the floor. This is your starting position." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Kurzhantel im oberen Arm, der gestreckt vor dir parallel zum Boden ist. Das ist deine Ausgangsposition."
          }
        }
      }
    },
    "Hold a dumbbell on each hand and lie on an incline bench that is set to an incline angle of no more than 30 degrees." : {
